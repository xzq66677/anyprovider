{
  "name": "anyprovider",
  "version": "0.1.0",
  "description": "Probe any OpenAI/Anthropic-compatible LLM gateway and generate ready-to-use provider config for ZCode, opencode, Claude Code, DeepSeek Harness, Continue, Cline, LiteLLM, aider, Zed, VS Code Copilot and more.",
  "type": "module",
  "bin": {
    "anyprovider": "src/cli.mjs",
    "anyprovider-wizard": "src/wizard.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/probe.test.mjs test/targets.test.mjs test/targets-new.test.mjs",
    "start": "node src/cli.mjs",
    "wizard": "node src/wizard.mjs",
    "mock": "node test/serve-mock.mjs"
  },
  "keywords": [
    "llm",
    "openai-compatible",
    "anthropic",
    "openrouter",
    "gateway",
    "provider",
    "onboarding",
    "opencode",
    "zcode",
    "claude-code",
    "deepseek-harness",
    "zed",
    "vscode-copilot",
    "windsurf",
    "continue",
    "cline",
    "litellm",
    "aider",
    "reasoning",
    "context-window"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzq66677/anyprovider.git"
  },
  "license": "MIT"
}
